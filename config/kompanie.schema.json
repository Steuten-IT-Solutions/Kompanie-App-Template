{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Steuten-IT-Solutions/Kompanie-App-Template/config/kompanie.schema.json",
  "title": "Kompanie-Konfiguration",
  "description": "Beschreibt eine Kompanie. Pflicht sind nur name und colors.primary, dazu ein Logo als assets/logo.png, .jpg oder .svg. Alles andere hat Standardwerte oder wird beim Build berechnet. Enthält keine Zugangsdaten – die Kompanie-Repos sind öffentlich.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "colors"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "description": "Voller Name, z. B. im Fenstertitel und in der Kopfzeile für Gäste.",
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "\\S"
    },
    "shortName": {
      "description": "Name unter dem App-Symbol auf dem Home-Bildschirm. Standard: name. Mehr als etwa 12 Zeichen werden auf dem Handy abgeschnitten.",
      "type": "string",
      "minLength": 1,
      "maxLength": 30,
      "pattern": "\\S"
    },
    "description": {
      "description": "Kurzbeschreibung im Manifest. Standard: „Die App der <name>“.",
      "type": "string",
      "maxLength": 200
    },
    "greeting": {
      "description": "Begrüßung in der Kopfzeile; {name} wird durch den Namen des Mitglieds ersetzt.",
      "type": "string",
      "default": "Hallo, {name}",
      "pattern": "\\{name\\}"
    },
    "guestWelcome": {
      "description": "Kurzer Willkommenstext für Gäste ohne Anmeldung, z. B. auf der Startseite.",
      "type": "string",
      "maxLength": 300
    },
    "labels": {
      "description": "Eigene Bezeichnungen. Nicht angegebene behalten den Standard.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roles": {
          "description": "Namen der festen Rollen (Gast, Anwärter, Mitglied, Admin) bei der Ersteinrichtung. Danach benennt und verwaltet der Admin die Rollen in der App (Einstellungen → Rollen); spätere Änderungen hier wirken nicht mehr. organizer und manager gelten nur für Installationen, die diese früheren Rollen schon hatten.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "guest": {
              "type": "string",
              "default": "Gast",
              "minLength": 1,
              "maxLength": 30,
              "pattern": "\\S"
            },
            "candidate": {
              "type": "string",
              "default": "Anwärter",
              "minLength": 1,
              "maxLength": 30,
              "pattern": "\\S"
            },
            "member": {
              "type": "string",
              "default": "Mitglied",
              "minLength": 1,
              "maxLength": 30,
              "pattern": "\\S"
            },
            "organizer": {
              "type": "string",
              "default": "Verwalter",
              "minLength": 1,
              "maxLength": 30,
              "pattern": "\\S"
            },
            "manager": {
              "type": "string",
              "default": "Leitung",
              "minLength": 1,
              "maxLength": 30,
              "pattern": "\\S"
            },
            "admin": {
              "type": "string",
              "default": "Admin",
              "minLength": 1,
              "maxLength": 30,
              "pattern": "\\S"
            }
          }
        },
        "sections": {
          "description": "Anzeigenamen der Bereiche in der Navigation und in Überschriften.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "events": {
              "type": "string",
              "default": "Termine",
              "minLength": 1,
              "maxLength": 30,
              "pattern": "\\S"
            },
            "news": {
              "type": "string",
              "default": "News",
              "minLength": 1,
              "maxLength": 30,
              "pattern": "\\S"
            },
            "gallery": {
              "type": "string",
              "default": "Galerie",
              "minLength": 1,
              "maxLength": 30,
              "pattern": "\\S"
            },
            "points": {
              "type": "string",
              "default": "Punkte",
              "minLength": 1,
              "maxLength": 30,
              "pattern": "\\S"
            },
            "penalties": {
              "type": "string",
              "default": "Strafen",
              "minLength": 1,
              "maxLength": 30,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "colors": {
      "description": "Nur die Grundfarben. Abstufungen und Dunkelmodus werden berechnet, der Kontrast wird geprüft.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary"
      ],
      "properties": {
        "primary": {
          "$ref": "#/$defs/color",
          "description": "Hauptfarbe: Kopfzeile, Knöpfe, Links."
        },
        "accent": {
          "$ref": "#/$defs/color",
          "description": "Akzentfarbe: Hervorhebungen. Standard: aus der Hauptfarbe berechnet."
        },
        "background": {
          "$ref": "#/$defs/color",
          "description": "Optional: Hintergrund im hellen Modus. Standard: ein helles, leicht getöntes Weiß."
        }
      }
    },
    "font": {
      "description": "Schrift für Überschriften, aus der mitgelieferten Auswahl. „System“ nutzt die Schrift des Geräts.",
      "type": "string",
      "enum": [
        "System",
        "Oswald",
        "Roboto Slab",
        "Source Sans 3"
      ],
      "default": "System"
    },
    "features": {
      "description": "Veraltet: Welche Bereiche die App hat, entscheidet der Admin der Kompanie in der App (Ersteinrichtung bzw. Einstellungen → Bereiche). Wird ignoriert; nur bestehende Installationen übernehmen die Werte einmalig beim Wechsel auf die neue Version.",
      "deprecated": true,
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "events": {
          "description": "Öffentliche Terminliste.",
          "type": "boolean",
          "default": true
        },
        "calendar": {
          "description": "Kalender mit allen Terminen für Mitglieder.",
          "type": "boolean",
          "default": true
        },
        "news": {
          "type": "boolean",
          "default": true
        },
        "gallery": {
          "type": "boolean",
          "default": true
        },
        "points": {
          "type": "boolean",
          "default": true
        },
        "penalties": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "legal": {
      "description": "Rechtstexte für die eigenständige Version ohne eigene Webseite. Alternativ legal/impressum.md und legal/datenschutz.md im Repo ablegen.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imprintUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "privacyUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    }
  }
}
