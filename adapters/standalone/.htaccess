# Kompanie-App (eigenständige Version) für Apache und LiteSpeed.
# Ohne mod_rewrite läuft die App trotzdem: dann über index.php?r=/…

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Programmcode und Daten sind nie direkt abrufbar.
  RewriteRule ^(data|src|core|bin)(/|$) - [F,L]
  RewriteRule ^(autoload\.php|data-dir\.php|VERSION|update\.json)$ - [F,L]
  # Arbeitsordner während eines Updates
  RewriteRule ^\.(neu|alt)- - [F,L]
  # Alles, was keine Datei ist, beantwortet index.php.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Komprimierung für App-Seite, API und Manifest (aus index.php) sowie sw.js.
# Zwischenspeicher und Komprimierung der App-Dateien: app/.htaccess und app/assets/.htaccess.
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
  </IfModule>
</IfModule>
