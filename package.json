{
  "name": "kompanie-app",
  "private": true,
  "workspaces": [
    "packages/branding",
    "packages/frontend"
  ],
  "scripts": {
    "branding": "npm run -w packages/branding brand --",
    "build": "npm run -w packages/frontend build",
    "typecheck": "npm run -w packages/frontend typecheck",
    "test:branding": "npm run -w packages/branding test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,css}\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "3.3.3"
  }
}
