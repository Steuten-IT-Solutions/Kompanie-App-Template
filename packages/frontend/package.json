{
  "name": "@kompanie-app/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "brand": "node ../branding/brand.mjs --out src/generated --public public",
    "dev": "npm run brand && npm run handbuch && npm run changelog && vite",
    "build": "npm run brand && npm run handbuch && npm run changelog && tsc --noEmit && vite build",
    "typecheck": "npm run brand && npm run handbuch && npm run changelog && tsc --noEmit",
    "test": "node --test test/*.test.mjs test/*.test.ts",
    "handbuch": "php ../../scripts/handbuch.php --app=src/generated/handbuch.json",
    "changelog": "php ../../scripts/changelog.php --app=src/generated/changelog.json"
  },
  "dependencies": {
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-file-handler": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@kompanie-app/branding": "*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "linkedom": "^0.18.14",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
