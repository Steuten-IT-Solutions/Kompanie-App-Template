{
    "name": "kompanie-app/kompanie-app",
    "description": "Gemeinsamer Kern der Kompanie-App mit WordPress-Plugin und eigenständiger Version",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "KompanieApp\\Core\\": "packages/core/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KompanieApp\\Core\\Tests\\": "packages/core/tests/",
            "KompanieApp\\Contract\\": "tests/contract/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
